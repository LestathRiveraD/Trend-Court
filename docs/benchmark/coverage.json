{
  "experiment": "coverage",
  "description": "Coverage of the Theil-Sen 95% interval (examiner.theil_sen defaults: confidence 0.95, method='separate') on monthly series with a known linear trend, seasonal cycle and stationary AR(1) noise, through trendcourt.benchmark.run_case (Theil-Sen on clerk.deseasonalize anomalies). A replicate covers when low <= true slope <= high. 'below_flag' means the coverage estimate is below 0.93; 'below_nominal' means the whole exact 95% binomial interval lies below 0.95. miss_low counts intervals entirely below the true slope, miss_high entirely above.",
  "grid": {
    "phi": [
      0.0,
      0.3,
      0.6,
      0.8,
      0.9
    ],
    "slope_per_decade": [
      0.1,
      0.3,
      0.5
    ],
    "n_years": [
      20,
      30,
      45
    ]
  },
  "replicates": 1000,
  "nominal": 0.95,
  "flag_below": 0.93,
  "series": {
    "start": "1981-01",
    "sigma": 1.0,
    "seasonal_amp": 10.0,
    "burn_in": 600,
    "sigma_meaning": "stationary standard deviation of the AR(1) noise",
    "slope_units": "noise SDs per decade (sigma = 1, so also units of the series per decade)"
  },
  "seeds": {
    "master": 18,
    "scheme": "numpy.random.default_rng((master, round(1000 * phi), round(1000 * slope), n_years, replicate))",
    "replicate_range": [
      0,
      999
    ]
  },
  "ci": {
    "level": 0.95,
    "method": "Clopper-Pearson (scipy.stats.binomtest, method='exact')"
  },
