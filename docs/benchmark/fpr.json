{
  "experiment": "fpr",
  "description": "Rejection rate of the trend tests on trend-free monthly series (seasonal cycle + stationary AR(1) noise), through trendcourt.benchmark.run_case: clerk.deseasonalize, examiner.mk_hamed_rao(anomalies, lag=3), examiner.mk_seasonal(raw). A test rejects when p < alpha. 'inflated' means the whole exact 95% binomial interval lies above alpha.",
  "grid": {
    "phi": [
      0.0,
      0.3,
      0.6,
      0.8,
      0.9
    ],
    "n_years": [
      20,
      30,
      45
    ]
  },
  "replicates": 1000,
  "series": {
    "start": "1981-01",
    "sigma": 1.0,
    "seasonal_amp": 10.0,
    "slope_per_decade": 0.0,
    "burn_in": 600,
    "sigma_meaning": "stationary standard deviation of the AR(1) noise"
  },
  "seeds": {
    "master": 17,
    "scheme": "numpy.random.default_rng((master, round(1000 * phi), n_years, replicate))",
    "replicate_range": [
      0,
      999
    ]
  },
  "alphas": [
    0.05,
    0.01
  ],
  "ci": {
    "level": 0.95,
    "method": "Clopper-Pearson (scipy.stats.binomtest, method='exact')"
  },
